# Port run app
PORT =

# token (legacy sign-in)
ACCESS_TOKEN =
REFRESH_TOKEN =
EXPIRES_ACCESS_TOKEN =
EXPIRES_REFRESH_TOKEN =

# Port connect db Postgre
DB_HOST =
DB_DATABASE =
DB_PORT =
DB_USER =
DB_PASSWORD =
# Only when the database needs a CA certificate
# DB_CA =

# Sign-in: legacy (default) or iam. See docs/IAM-MIGRATION.md
AUTH_MODE = legacy

# Needed when AUTH_MODE = iam
# IAM_ISSUER = https://auth.vantuankhanh.com
# IAM_CLIENT_ID = taskmanager-v1
# IAM_CLIENT_SECRET =
# IAM_API_AUDIENCE = https://api-taskmanager-v1.vantuankhanh.com/api
# APP_BASE_URL = https://api-taskmanager-v1.vantuankhanh.com
# The frontend, without a path. The app derives two pages from it:
#   FRONTEND_BASE_URL + /auth/login   after sign-out (register it at the IAM as a post-logout redirect URI)
#   FRONTEND_BASE_URL + /auth/access  after a sign-in that failed (?reason=access_denied or sign_in_failed)
# FRONTEND_BASE_URL = https://taskmanagerv1.vantuankhanh.com
# At least 32 random characters: openssl rand -base64 48
# COOKIE_SECRET =
